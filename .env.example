# Copy to .env (make setup does this) and fill in. .env is gitignored; never commit secrets.
# Every variable used anywhere in the project is listed here. Optional ones are marked.
# Defaults target the local compose CPU stack (make up). If a default host port is taken, change
# the *_PORT variable and the matching URL together.

# --- General (vms.common.settings) ---
# Service settings come from configs/*.yaml. Any field can be overridden with VMS_<FIELD>, using
# "__" for nesting, e.g. VMS_LOG__LEVEL, VMS_TELEMETRY__SAMPLE_RATIO.
# local | ci | cloud; selects configs/<service>.<env>.yaml overlays
VMS_ENV=local
VMS_LOG__LEVEL=INFO
# default seed for runs that don't set their own
VMS_SEED=1234

# --- Postgres (metadata DB, Phase 1 detection store) ---
POSTGRES_HOST=localhost
# also the host port compose publishes
POSTGRES_PORT=5432
POSTGRES_DB=vms
POSTGRES_USER=vms
POSTGRES_PASSWORD=change-me
# read-only role used by the query service
POSTGRES_READONLY_USER=vms_query
POSTGRES_READONLY_PASSWORD=change-me

# --- Object store (SeaweedFS locally, S3 in the cloud; see D12) ---
# host port compose publishes; keep S3_ENDPOINT_URL in step
S3_PORT=8333
# leave empty to use AWS S3
S3_ENDPOINT_URL=http://localhost:8333
# created on startup by the local object store
S3_BUCKET=vms-frames
# local object store admin identity
S3_ACCESS_KEY_ID=vms-local
S3_SECRET_ACCESS_KEY=change-me-s3
# S3_REGION: optional; empty uses AWS_REGION, then us-east-1 (the local store ignores it)
S3_REGION=

# --- Observability ---
# host ports compose publishes for the OTel collector
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME: optional; each service sets its own default
OTEL_SERVICE_NAME=
OTEL_SDK_DISABLED=false
# false: no-op tracer, nothing exported
VMS_TELEMETRY__ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
TEMPO_PORT=3200
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- LLM (query planner) ---
# LLM_BASE_URL: OpenAI-compatible endpoint (Ollama locally, or a hosted API). For the containerized
# query service (make app, make demo) with Ollama on the host, use http://host.docker.internal:11434/v1.
LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL: empty: the canned planner (demo questions only); e.g. qwen2.5:7b
LLM_MODEL=
# LLM_API_KEY: optional; only for a hosted provider
LLM_API_KEY=
# auto (openai if LLM_MODEL is set, else canned) | openai | canned
VMS_LLM__PROVIDER=auto
# json_schema (Ollama, vLLM, OpenAI) | json_object (DeepSeek) | none
VMS_LLM__RESPONSE_FORMAT=json_schema

# --- Application containers (make app) ---
# host port for the containerized query service and UI
QUERY_PORT=8070
# host port for the containerized ingest (make demo; loadgen sends here)
INGEST_PORT=8080
# host port for the containerized worker's probes and /metrics
WORKER_PORT=8090
# containerized worker's detector backend: ultralytics (PyTorch) | onnxruntime (needs make onnx); D5
WORKER_BACKEND=ultralytics
# frames per forward pass in the containerized worker (1 to queue.claim_batch); task 5.5
WORKER_INFER_BATCH=1
# onnxruntime only: idle inference threads busy-wait between frames (true, ORT default) or sleep
WORKER_SPIN=true
# EXTRA_CA_CERT: optional; CA file for image builds behind a TLS-intercepting proxy. Keep it inside
# the repo (newer Compose refuses secret files outside it), e.g. .certs/proxy-ca.pem (gitignored);
# a relative path resolves from deploy/compose/, so write ../../.certs/proxy-ca.pem.
EXTRA_CA_CERT=

# --- AWS (optional; not needed for the local demo) ---
AWS_PROFILE=
# AWS_REGION: the project's selected Region (AWS Settings > project > Overview)
AWS_REGION=
# GPU sessions (scripts/gpu_session.sh) use AWS_PROFILE and AWS_REGION above; each session
# generates its own id (tag session=<id>). Settings: configs/cloud.yaml (VMS_INSTANCE_TYPE etc.).
