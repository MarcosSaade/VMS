# Copy to .env (make setup does this) and fill in. .env is gitignored; never commit secrets.
# Every variable used anywhere in the project is listed here. Optional ones are marked.
# Defaults target the local compose CPU stack.

# --- General (vms.common.settings) ---
# Service settings come from configs/*.yaml. Any field can be overridden with VMS_<FIELD>, using
# "__" for nesting, e.g. VMS_LOG__LEVEL, VMS_TELEMETRY__SAMPLE_RATIO, VMS_TRACKING__BACKENDS.
VMS_ENV=local                 # local | ci | cloud; selects configs/<service>.<env>.yaml overlays
VMS_LOG__LEVEL=INFO
VMS_SEED=1234                 # default seed for runs that don't set their own
VMS_TRACKING__BACKENDS=["noop"]   # JSON list of: noop, mlflow, wandb

# --- Postgres (metadata DB, Phase 1 detection store) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vms
POSTGRES_USER=vms
POSTGRES_PASSWORD=change-me
POSTGRES_READONLY_USER=vms_query      # read-only role used by the query service
POSTGRES_READONLY_PASSWORD=change-me

# --- Object store (MinIO locally, S3 in the cloud) ---
S3_ENDPOINT_URL=http://localhost:9000  # leave empty to use AWS S3
S3_BUCKET=vms-frames
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- Redis (queue candidate, query cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=                    # optional; each service sets its own default
OTEL_SDK_DISABLED=false
VMS_TELEMETRY__ENABLED=true          # false: no-op tracer, nothing exported

# --- Inference ---
TRITON_URL=localhost:8001             # Triton gRPC (Phase 5+)

# --- LLM (query planner) ---
LLM_BASE_URL=http://localhost:11434/v1  # OpenAI-compatible endpoint (Ollama locally, vLLM later)
LLM_MODEL=
LLM_API_KEY=                          # optional; only for a hosted provider
ANTHROPIC_API_KEY=                    # optional; hosted fallback

# --- Experiment tracking ---
MLFLOW_TRACKING_URI=http://localhost:5000
WANDB_MODE=disabled                   # optional: disabled | offline | online
WANDB_API_KEY=                        # optional; only needed when WANDB_MODE=online
WANDB_PROJECT=vms                     # optional
WANDB_ENTITY=                         # optional

# --- AWS (optional; not needed for the local demo) ---
AWS_PROFILE=
AWS_REGION=                           # the project's selected Region (AWS Settings > project > Overview)
GPU_SESSION_ID=                       # tag value session=<id> for GPU sessions (scripts only)
