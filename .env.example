# Copy to .env (make setup does this) and fill in. .env is gitignored; never commit secrets.
# Every variable used anywhere in the project is listed here. Optional ones are marked.
# Defaults target the local compose CPU stack (make up). If a default host port is taken, change
# the *_PORT variable and the matching URL together.

# --- General (vms.common.settings) ---
# Service settings come from configs/*.yaml. Any field can be overridden with VMS_<FIELD>, using
# "__" for nesting, e.g. VMS_LOG__LEVEL, VMS_TELEMETRY__SAMPLE_RATIO.
VMS_ENV=local                 # local | ci | cloud; selects configs/<service>.<env>.yaml overlays
VMS_LOG__LEVEL=INFO
VMS_SEED=1234                 # default seed for runs that don't set their own

# --- Postgres (metadata DB, Phase 1 detection store) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432                    # also the host port compose publishes
POSTGRES_DB=vms
POSTGRES_USER=vms
POSTGRES_PASSWORD=change-me
POSTGRES_READONLY_USER=vms_query      # read-only role used by the query service
POSTGRES_READONLY_PASSWORD=change-me

# --- Object store (SeaweedFS locally, S3 in the cloud; see D12) ---
S3_PORT=8333                          # host port compose publishes; keep S3_ENDPOINT_URL in step
S3_ENDPOINT_URL=http://localhost:8333  # leave empty to use AWS S3
S3_BUCKET=vms-frames                  # created on startup by the local object store
S3_ACCESS_KEY_ID=vms-local            # local object store admin identity
S3_SECRET_ACCESS_KEY=change-me-s3
S3_REGION=                            # optional; empty uses AWS_REGION, then us-east-1 (the local store ignores it)

# --- Observability ---
OTEL_GRPC_PORT=4317                   # host ports compose publishes for the OTel collector
OTEL_HTTP_PORT=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=                    # optional; each service sets its own default
OTEL_SDK_DISABLED=false
VMS_TELEMETRY__ENABLED=true          # false: no-op tracer, nothing exported
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
TEMPO_PORT=3200
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- LLM (query planner) ---
LLM_BASE_URL=http://localhost:11434/v1  # OpenAI-compatible endpoint (Ollama locally, or a hosted API)
LLM_MODEL=                            # empty: the canned planner (demo questions only); e.g. qwen2.5:7b
LLM_API_KEY=                          # optional; only for a hosted provider
VMS_LLM__PROVIDER=auto                # auto (openai if LLM_MODEL is set, else canned) | openai | canned
VMS_LLM__RESPONSE_FORMAT=json_schema  # json_schema (Ollama, vLLM, OpenAI) | json_object (DeepSeek) | none

# --- AWS (optional; not needed for the local demo) ---
AWS_PROFILE=
AWS_REGION=                           # the project's selected Region (AWS Settings > project > Overview)
GPU_SESSION_ID=                       # tag value session=<id> for GPU sessions (scripts only)
