    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Worker cameras leased",
      "description": "Cameras each worker holds (D20). Scaling is by cameras: a worker at max_cameras while others hold none means leases are not spreading.",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
