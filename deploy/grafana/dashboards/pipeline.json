    {
      "id": 12,
      "type": "timeseries",
      "title": "Where freshness goes: waiting vs working",
      "description": "Mean time a frame waits in the queue against the mean time a worker spends on it (all stages), on a log scale. Waiting dominating means too little worker capacity; working dominating means the per-frame path itself is slow (see Inference).",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(vms_worker_queue_wait_seconds_sum[$__rate_interval])) / sum(rate(vms_worker_queue_wait_seconds_count[$__rate_interval]))",
          "legendFormat": "queue wait",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(rate(vms_worker_stage_duration_seconds_sum{stage=~\"claim|fetch|decode|stats|infer|track|write\"}[$__rate_interval])) / sum(rate(vms_worker_frames_total{outcome=\"done\"}[$__rate_interval]))",
          "legendFormat": "worker time per frame",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum(rate(vms_ingest_capture_to_receive_seconds_sum[$__rate_interval])) / sum(rate(vms_ingest_capture_to_receive_seconds_count[$__rate_interval]))",
          "legendFormat": "capture to ingest",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "palette-classic"
          },
