    {
      "id": 9,
      "type": "timeseries",
      "title": "Frames in vs out",
      "description": "Ingest and worker throughput. The gap between the lines is the rate at which the backlog grows: the first signal of overload.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
