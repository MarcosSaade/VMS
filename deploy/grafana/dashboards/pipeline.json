    {
      "id": 14,
      "type": "timeseries",
      "title": "Frames lost or retried",
      "description": "Frames ingest refused (invalid, error) and frames the workers failed, retried or lost to a lease takeover. Any non-zero line breaks the zero-frame-loss condition of rated capacity.",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
