          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum(rate(vms_worker_frames_total{outcome=\"done\"}[$__rate_interval]))",
