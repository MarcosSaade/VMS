    "queries": {
      "ingest_created_fps": {
        "query": "sum(rate(vms_ingest_frames_total{outcome=\"created\"}[$window]))",
        "by": null
      },
      "ingest_rejected_fps": {
        "query": "sum(rate(vms_ingest_frames_total{outcome=~\"invalid|error\"}[$window]))",
        "by": null
      },
      "worker_done_fps": {
        "query": "sum(rate(vms_worker_frames_total{outcome=\"done\"}[$window]))",
        "by": null
      },
      "worker_lost_frames": {
        "query": "sum(increase(vms_worker_frames_total{outcome=~\"lost|failed\"}[$window]))",
        "by": null
      },
      "freshness_p50_s": {
        "query": "histogram_quantile(0.50, sum by (le) (rate(vms_worker_capture_to_done_seconds_bucket[$window])))",
        "by": null
      },
      "freshness_p95_s": {
        "query": "histogram_quantile(0.95, sum by (le) (rate(vms_worker_capture_to_done_seconds_bucket[$window])))",
        "by": null
      },
      "freshness_p99_s": {
        "query": "histogram_quantile(0.99, sum by (le) (rate(vms_worker_capture_to_done_seconds_bucket[$window])))",
        "by": null
      },
      "queue_wait_p95_s": {
        "query": "histogram_quantile(0.95, sum by (le) (rate(vms_worker_queue_wait_seconds_bucket[$window])))",
        "by": null
      },
      "worker_stage_p95_s": {
        "query": "histogram_quantile(0.95, sum by (le, stage) (rate(vms_worker_stage_duration_seconds_bucket[$window])))",
        "by": "stage"
      },
      "backlog_end_frames": {
        "query": "max(vms_worker_backlog_frames)",
        "by": null
      },
      "backlog_max_frames": {
        "query": "max_over_time(max(vms_worker_backlog_frames)[$window:5s])",
        "by": null
      },
      "backlog_slope_fps": {
        "query": "deriv(max(vms_worker_backlog_frames)[$window:5s])",
        "by": null
      },
      "backlog_age_max_s": {
        "query": "max_over_time(max(vms_worker_backlog_age_seconds)[$window:5s])",
        "by": null
      },
      "query_stage_p95_s": {
        "query": "histogram_quantile(0.95, sum by (le, stage) (rate(vms_query_stage_duration_seconds_bucket[$window])))",
        "by": "stage"
      },
      "cpu_cores": {
        "query": "sum by (job) (rate(process_cpu_seconds_total{job=~\"ingest|worker|query\"}[$window]))",
        "by": "job"
      },
      "rss_max_bytes": {
        "query": "max by (job) (max_over_time(process_resident_memory_bytes{job=~\"ingest|worker|query\"}[$window]))",
        "by": "job"
      }
    }
  },
  "scenario": {
