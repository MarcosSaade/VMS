    "repeats": 3,
    "warmup_s": 10,
    "hold_s": 20,
    "ingest": {
      "cameras": [
        1,
        2
      ],
      "fps": 5
    },
    "query": {
      "concurrency": [
        1
      ],
      "questions": "configs/demo/canned_plans.v1.jsonl"
    }
  },
